# Sotuvchi kabineti — production sozlamalari.
# Serverga `.env.production` nomi bilan qo'yiladi (git'ga tushmaydi).

# Backend API manzili. Backend .env.production'dagi DOMAIN bilan mos bo'lishi
# va /api/v1 bilan tugashi kerak.
VITE_API_URL=https://api.marketplace.example.com/api/v1

# Domen hali olinmagan va API HTTP orqali sinalayotgan bo'lsa `true` qiling.
# Bu holda token va parollar shifrlanmagan ketadi — faqat sinov uchun.
# VITE_ALLOW_INSECURE_API=true

# SPA qaysi portda ochilsin (domen yo'q bo'lganda).
# FRONTEND_HTTP_PORT=8080
