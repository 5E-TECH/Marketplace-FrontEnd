# `npm run dev:api` — haqiqiy backend bilan. API bir xil origin orqali Vite proxy'dan
# serverga uzatiladi. DIQQAT: sukut — production API; lokal backend uchun
# `.env.api.local` ga `VITE_DEV_API_PROXY=http://localhost:3000` yozing.
VITE_API_URL=/api/v1
VITE_API_MOCKS=false
VITE_DEV_API_PROXY=https://api.elchimarket.uz
